{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \".claude/hooks/eslint-fix.ps1\"",
            "timeout": 30,
            "statusMessage": "ESLint fix..."
          }
        ]
      }
    ]
  }
}
