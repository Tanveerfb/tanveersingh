{
  "extraKnownMarketplaces": {
    "tanveerfb": {
      "source": {
        "source": "github",
        "repo": "Tanveerfb/fleet-standards"
      }
    }
  },
  "enabledPlugins": {
    "fleet@tanveerfb": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/fleet/scripts/block-shell-writes.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
