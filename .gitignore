# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (names only in .env.example, which is committed)
.env*
!.env.example

# credentials (§SECURITY)
.secrets/

# mockup drafts (§OWNER) — locked ones move to docs/design/
/public/_mockups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
